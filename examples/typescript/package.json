{
  "name": "wallets-payments-api",
  "version": "1.0.0",
  "description": "Wallets/Payments API example for api-test-coverage-analyzer",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/server.js",
    "dev": "ts-node src/server.ts",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:blackbox": "jest --testPathPattern=tests/blackbox",
    "test:wiremock": "jest --testPathPattern=tests/wiremock",
    "test": "jest",
    "analyze": "bash scripts/run-analyzer.sh",
    "screenshots": "node scripts/generate-screenshots.js"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.0",
    "jsonwebtoken": "^9.0.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.0",
    "@types/uuid": "^9.0.0",
    "jest": "^29.7.0",
    "nock": "^13.4.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  }
}
