{
  "name": "logistics-tracking-api",
  "version": "1.0.0",
  "description": "Logistics & Shipment Tracking Platform — example project for API coverage analysis",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "jest",
    "test:initial": "jest tests/tests-initial",
    "test:complete": "jest tests/tests-complete",
    "test:coverage": "jest --coverage",
    "analyze": "node scripts/run-analyzer.js",
    "analyze:initial": "node scripts/run-analyzer.js --tests tests-initial",
    "analyze:complete": "node scripts/run-analyzer.js --tests tests-complete",
    "lint": "eslint src tests --ext .js"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/helpers/"
    ],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ]
  },
  "keywords": [
    "logistics",
    "shipping",
    "tracking",
    "express",
    "nodejs",
    "api",
    "example"
  ],
  "license": "MIT"
}
